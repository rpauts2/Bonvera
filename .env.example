BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
ADMINS=123456789
DB_URL=postgresql+asyncpg://cashback:CHANGE_ME@localhost:5432/cashback
REDIS_URL=redis://localhost:6379/0
HASH_SALT=GENERATE_64_HEX_CHARS
PHONE_ENCRYPTION_KEY=GENERATE_64_HEX_CHARS_AND_BACKUP_IT
POSTBACK_SECRET=GENERATE_64_HEX_CHARS
WEB_PORT=8080
BK_ENABLED=true
MFO_ENABLED=true
CPL_ENABLED=true
REF_PERCENT=7
BOOKING_HOURS=48
MIN_WITHDRAW=300
MAX_ACTIVE=3
POSTGRES_PASSWORD=GENERATE_64_HEX_CHARS

# --- Mini App (TMA) ---
# Публичный HTTPS-адрес SPA, например https://bonvera.example.com/app
# Пусто = кнопка приложения и menu button не показываются.
WEBAPP_URL=
# Канал для бонуса +20 ₽ за подписку. ID вида -100... или @username, URL вида https://t.me/...
# Оба обязательны для начисления; пусто = бонус временно недоступен (честное сообщение в приложении).
BONVERA_CHANNEL_ID=
BONVERA_CHANNEL_URL=
# Ссылка на поддержку (кнопка в приложении), например https://t.me/your_support
BONVERA_SUPPORT_URL=
# Время жизни сессии Mini App в часах
TMA_SESSION_HOURS=24

# --- Политика хранения доказательств ---
# Сколько дней хранятся файлы доказательств закрытой сделки (paid/confirmed/rejected/expired).
# Метаданные (что загружено, хеши, даты) и события сделки остаются в базе для аудита —
# удаляются только персональные байты файлов.
PROOF_RETENTION_DAYS=180
# Сколько дней ждут незакрытые сделки (new/proof/hold): пользователь может вернуться позже.
PROOF_OPEN_GRACE_DAYS=365
# Автоматическая чистка по расписанию. false = файлы не удаляются автоматически.
PROOF_PURGE_ENABLED=true

# --- Мониторинг ---
# Как часто проверять живость БД и Telegram API (минут).
HEALTH_INTERVAL_MIN=5
# Как часто повторять алерт администраторам при повторной поломке (минут).
HEALTH_ALERT_COOLDOWN_MIN=30
