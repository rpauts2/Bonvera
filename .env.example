# --- Mini App (TMA) ---
# Публичный HTTPS-адрес SPA, например https://bonvera.example.com/app
# Пусто = кнопка приложения и menu button не показываются.
WEBAPP_URL=
# Канал для бонуса +20 ₽ за подписку. ID вида -100... или @username, URL вида https://t.me/...
# Оба обязательны для начисления; пусто = бонус временно недоступен (честное сообщение в приложении).
BONVERA_CHANNEL_ID=
BONVERA_CHANNEL_URL=
# Ссылка на поддержку (кнопка в приложении), например https://t.me/your_support
BONVERA_SUPPORT_URL=
# Время жизни сессии Mini App в часах
TMA_SESSION_HOURS=24
